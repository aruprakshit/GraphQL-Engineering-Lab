{
  "name": "graphql-engineering-lab",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "seed": "tsx src/seed.ts",
    "db:indexes": "tsx src/create-indexes.ts",
    "account:provision": "tsx src/auth/provision.ts",
    "dev": "node --watch --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import tsx/esm --import ./src/instrumentation.ts src/main.ts",
    "test": "node --import tsx/esm --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx/esm --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "schema:baseline": "node --import tsx/esm src/schema/export-baseline.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@graphile/depth-limit": "0.4.0",
    "@inquirer/prompts": "^8.7.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-mongodb": "^0.76.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "dataloader": "^2.2.3",
    "express": "^5.2.1",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1",
    "graphql-query-complexity": "2.0.0",
    "mongodb": "^7.7.0",
    "ruru": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prettier": "3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
