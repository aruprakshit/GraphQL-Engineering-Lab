# Copy the structure into .env or use the README's Docker-only generation command.
# Use your actual WSL/Linux IDs: id -u and id -g.
LOCAL_UID=1000
LOCAL_GID=1000

# Required: generate 32 random bytes as 64 lowercase hexadecimal characters.
# Never commit the real value. Both applications receive the same service token.
USER_SERVICE_TOKEN=
