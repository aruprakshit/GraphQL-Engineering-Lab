flowchart TB
    user["Learner / developer<br/>[Person]"]
    subgraph system["GraphQL Engineering Lab - software system boundary"]
        api["Backend API<br/>[Container: Node.js, Express, TypeScript]<br/>Serves playground, executes GraphQL,<br/>batches authors and issues login sessions"]
        db[("Application database<br/>[Container: MongoDB]<br/>Users, posts, accounts,<br/>sessions and learning checks")]
        api -->|Reads and writes documents using MongoDB wire protocol| db
    end
    jaeger["Jaeger<br/>[Supporting software system]<br/>Trace receiver and inspection UI"]
